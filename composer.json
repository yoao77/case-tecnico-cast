{
    "name": "case-tecnico/api-transferencias",
    "description": "API de transferências entre contas fictícias",
    "type": "project",
    "require": {
        "php": "^8.4",
        "monolog/monolog": "^3.12",
        "php-di/php-di": "^7.1",
        "ramsey/uuid": "^4.9",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest"
    },
    "require-dev": {
        "pestphp/pest": "^5.3"
    }
}
